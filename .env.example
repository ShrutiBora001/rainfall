# Rain — auth header is `api-key` (confirmed against the live API)
RAIN_API_KEY=
RAIN_TEAM_ID=
RAIN_USER_ID=
RAIN_COLLATERAL_CONTRACT_ID=
# api.rain.xyz is production; api-dev.rain.xyz answers identically and is the
# likely sandbox. Confirm with the Rain team before relying on either.
RAIN_BASE_URL=https://api.rain.xyz

# Monad testnet
# Verified working. Note it is testnet-rpc.monad.xyz, NOT rpc.testnet.monad.xyz
# (the latter does not resolve). Backup: https://monad-testnet.drpc.org
MONAD_RPC=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
DEPLOYER_PRIVATE_KEY=

# Demo pacing: one installment every N seconds instead of monthly
INSTALLMENT_INTERVAL_SECONDS=20

# Agent — needed for the live Claude tool loop.
# Without it the portal falls back to a scripted agent and says so on screen.
ANTHROPIC_API_KEY=
